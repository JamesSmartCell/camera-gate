PORT=8787
HOST=0.0.0.0

# Leave empty so stream URLs stay relative (/live/<token>).
PUBLIC_BASE_URL=

WALLET_ORIGINS=https://wallet.percolate.one,http://localhost:8089

NFT_CONTRACT=0x3158e836ec0e85A46f7a7208d91EA9837A0C6ccC
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
ADMIN_ADDRS=0xC067A53c91258ba513059919E03B81CF93f57Ac7,0x7e4b1da13c4a2a73fd05e928a6ed81b0a5d3007b

STREAM_MODE=mjpeg

# Leave CAMERA_SOURCE_URL empty: camera-gate starts ffmpeg only while someone is watching.
CAMERA_SOURCE_URL=
CAMERA_DEVICE=/dev/video0
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_SIZE=1280x720
CAMERA_FPS=15
# Built-in cam sits upside down. CAMERA_VFLIP=0 to disable. CAMERA_HFLIP=1 if left/right is also wrong.
CAMERA_VFLIP=1
CAMERA_HFLIP=0
# CAMERA_ENCODE=1 if the webcam is not already MJPEG (vflip already forces encode)
FFMPEG_IDLE_STOP_MS=2000

STREAM_TTL_SEC=90
MAX_SESSION_SEC=600
